DB_DIALECT=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=seu_usuario_aqui
DB_PASSWORD=sua_senha_aqui
DB_NAME=lp_contabil_portal

# Porta da API (padrão 3333)
PORT=3333

# Redis (fila BullMQ de geração de PDFs). No docker-compose é definido como "redis".
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Cloudinary: armazenamento dos PDFs dos relatórios (obrigatório para gerar/excluir PDFs)
CLOUDINARY_CLOUD_NAME=seu_cloud_name_aqui
CLOUDINARY_API_KEY=sua_api_key_aqui
CLOUDINARY_API_SECRET=seu_api_secret_aqui

# Chromium usado pelo Puppeteer. O Dockerfile já define /usr/bin/chromium;
# em ambiente local deixe vazio para usar o Chromium baixado pelo Puppeteer.
PUPPETEER_EXECUTABLE_PATH=

# Frontend do portal (servido em /portal/): URL base da API usada pelo navegador.
# Vazio = mesma origem do portal (recomendado quando o Nest serve o frontend).
PORTAL_API_BASE_URL=
