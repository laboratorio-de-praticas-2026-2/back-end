{
  "info": {
    "name": "Portal Contabil - Rotas existentes",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Testes locais das 7 rotas implementadas. Executar na ordem. Contato restaurado ao final do fluxo. Mensagem e cliente de teste permanecem no historico/banco (nao existem rotas de exclusao). Disparos sao simulados."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3333"
    }
  ],
