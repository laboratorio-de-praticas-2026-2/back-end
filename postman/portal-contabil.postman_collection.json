    {
      "name": "03 - Cadastro de clientes (banco local)",
      "item": [
        {
          "name": "Criar cliente de teste",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const digits = Array.from({length: 9}, () => Math.floor(Math.random()*10));",
                  "function check(ds) { const rem = ds.reduce((sum, d, i) => sum+d*(ds.length+1-i),0)%11; return rem<2?0:11-rem; }",
                  "digits.push(check(digits)); digits.push(check(digits));",
                  "pm.collectionVariables.set(\"clienteCpf\",digits.slice(0,3).join(\"\")+\".\"+digits.slice(3,6).join(\"\")+\".\"+digits.slice(6,9).join(\"\")+\"-\"+digits.slice(9).join(\"\"));",
                  "pm.collectionVariables.set(\"clienteEmail\",\"postman.\"+pm.variables.replaceIn(\"{{$guid}}\")+\"@example.com\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Cliente criado sem expor senha\", () => { const r=pm.response.json(); pm.expect(r.id).to.be.a(\"number\"); pm.expect(r.email).to.eql(pm.collectionVariables.get(\"clienteEmail\")); pm.expect(r).not.to.have.property(\"senha\"); pm.collectionVariables.set(\"clienteId\",r.id); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/clientes",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Cliente Teste Postman\",\n  \"email\": \"{{clienteEmail}}\",\n  \"senha\": \"TestePostman123!\",\n  \"cpfCnpj\": \"{{clienteCpf}}\",\n  \"celular\": \"11999999999\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
